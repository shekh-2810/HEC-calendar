# Shared admin passcode
ADMIN_PASSWORD=change-this-passcode

# Long random secret used to sign the 7-day admin session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Optional. Maximum upload size is enforced by the upload API at 2 MB.
# DATA_FILE is intentionally not required; calendar data is stored in data/calendar.json.
